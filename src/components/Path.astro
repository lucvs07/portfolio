---
import { getDict } from "../i18n/index";
import type { Lang } from "../i18n/types";
import { SECTION_IDS } from "./sections";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---
<section id={SECTION_IDS[lang].path} class="section" aria-labelledby="path-title">
  <div class="wrap">
    <p class="num">04 — {t.nav.path}</p>
    <h2 id="path-title" class="title">{t.path.title}</h2>
    <ol class="tl">
      {t.path.items.map((item) => (
        <li class="item">
          <p class="period muted">{item.period}</p>
          <div>
            <h3>{item.org}</h3>
            <p>{item.role}</p>
            {item.note && <p class="muted note">{item.note}</p>}
            {item.steps && (
              <ol class="rail">
                {item.steps.map((s) => (
                  <li class:list={["step", { full: s.full }]}>
                    <p class="period muted">{s.period}</p>
                    <h4>{s.title}{s.partner && <span class="partner"> | {s.partner}</span>}</h4>
                    {s.result && <p class="muted">{s.result}</p>}
                  </li>
                ))}
              </ol>
            )}
            {item.legend && <p class="muted legend">{item.legend}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .tl { position: relative; list-style: none; margin-top: 3rem; }
  /* A linha do tempo cresce com a rolagem (--tl de 0 a 1); sem JS fica inteira. */
  .tl::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 1px; background: linear-gradient(var(--accent), var(--rule) 40%); transform-origin: top; scale: 1 var(--tl, 1); }
  .item { position: relative; z-index: 0; display: grid; gap: 0.25rem 2rem; padding: 0 0 2.75rem 2rem; }
  @media (min-width: 900px) { .item { grid-template-columns: 11rem 1fr; } }
  .item::before { content: ""; position: absolute; left: -0.3rem; top: 0.45rem; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--accent); scale: var(--dot, 1); }
  h3 { font-size: 1.3rem; font-weight: 600; }
  .period { font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .note { margin-top: 0.25rem; font-size: 1rem; }

  /* Trilho de um marco: cargos ou desafios em ordem. Ponto vazado por padrão, cheio quando marcado (a legenda diz o quê).
     O traço se desenha com --rail (0 a 1) e cada ponto acende com --dot; sem JS ficam inteiros. */
  .rail { position: relative; list-style: none; display: grid; margin-top: 1.5rem; margin-left: 0.3rem; }
  .rail::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 1px; background: var(--rule); transform-origin: top; scale: 1 var(--rail, 1); }
  .step { position: relative; padding: 0 0 1rem 1.25rem; }
  .step::before { content: ""; position: absolute; left: -0.35rem; top: 0.45rem; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--accent); scale: var(--dot, 1); }
  .step.full::before { background: var(--accent); }
  @media (min-width: 700px) {
    .rail { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-left: 0; }
    .rail::before { inset: 0.35rem 0 auto; width: auto; height: 1px; transform-origin: left; scale: var(--rail, 1) 1; }
    .step { padding: 1.4rem 0 0; }
    .step::before { left: 0; top: 0; }
  }
  h4 { font-size: 1.1rem; font-weight: 600; line-height: 1.3; }
  .partner { color: var(--muted); white-space: nowrap; }
  .step p { font-size: 1rem; }
  .legend { margin-top: 0.5rem; font-size: 0.9rem; }
</style>
