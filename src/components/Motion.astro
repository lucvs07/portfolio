---
// Movimento do site inteiro (GSAP). O conteúdo é visível por padrão: só escondemos o que vai
// animar quando o script de boot marcou <html class="motion"> e este script chegou a rodar.
---
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);
  const root = document.documentElement;
  root.classList.add("motion-on");

  const EASE = "expo.out";
  const $ = <T extends Element = HTMLElement>(sel: string, scope: ParentNode = document) => scope.querySelector<T>(sel);
  const $$ = <T extends Element = HTMLElement>(sel: string, scope: ParentNode = document) => [...scope.querySelectorAll<T>(sel)];
  const onEnter = (trigger: Element, start = "top 82%") => ({ trigger, start, once: true });

  // Progresso de leitura e seção ativa: informação de estado, vale também com movimento reduzido.
  const progress = $(".progress");
  if (progress) {
    gsap.set(progress, { scaleX: 0 });
    ScrollTrigger.create({ start: 0, end: "max", onUpdate: (s) => gsap.set(progress, { scaleX: s.progress }) });
  }
  for (const a of $$<HTMLAnchorElement>(".bar nav a[href*='#']")) {
    const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (!target) continue;
    ScrollTrigger.create({
      trigger: target,
      start: "top 45%",
      end: "bottom 45%",
      onToggle: (s) => a.classList.toggle("is-active", s.isActive),
    });
  }

  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", (ctx) => {
    // O hero tem as linhas marcadas no HTML e começa já; o resto divide texto e depende
    // da quebra de linha, então espera o Chillax.
    hero();
    // ctx.add: o que nasce depois do await também é desfeito se o visitante ligar "reduzir movimento".
    document.fonts.ready.then(() => ctx.add(() => {
      sections();
      about();
      projects();
      path();
      contact();
      footer();
      ScrollTrigger.refresh();
    }));
  });

  /* Hero: o nome sobe de dentro das linhas, o ponto laranja pousa por último, a régua se desenha. */
  function hero() {
    const name = $(".hero .name");
    // Se o fallback do boot já mostrou o hero (script demorou), não reanima por cima.
    if (!name || !root.classList.contains("motion")) return;
    const lines = $$(".ln > span", name);
    const dot = $(".dot", name);
    const tl = gsap.timeline({ defaults: { ease: EASE } });
    tl.set([name, ".hero .lead", ".hero .index"], { autoAlpha: 1 })
      .from(lines, { yPercent: 110, duration: 1.2, stagger: 0.12 }, 0.15)
      .from(dot, { scale: 0, transformOrigin: "50% 85%", duration: 0.7, ease: "back.out(2.6)" }, 0.95)
      .from(".hero .lead", { y: 18, autoAlpha: 0, filter: "blur(6px)", duration: 1 }, 0.7)
      .from(".hero .index", { clipPath: "inset(0 100% 0 0)", duration: 1.4, ease: "power3.inOut" }, 0.9);
  }

  /* Cada seção: a régua do topo se desenha, o número se digita, o título sobe linha a linha. */
  function sections() {
    for (const s of $$(".section")) {
      const tl = gsap.timeline({ scrollTrigger: onEnter(s, "top 88%"), defaults: { ease: EASE } });
      tl.fromTo(s, { "--rule-x": 0 }, { "--rule-x": 1, duration: 1.4, ease: "power3.inOut" });
      const num = $(".num", s);
      if (num) {
        tl.from(num, { clipPath: "inset(0 100% 0 0)", duration: 0.5, ease: "steps(10)" }, 0.2);
      }
      const title = $(".title", s);
      if (title) {
        const lines = SplitText.create(title, { type: "lines", mask: "lines" }).lines;
        tl.from(lines, { yPercent: 105, duration: 1.1, stagger: 0.1 }, 0.3);
      }
    }
  }

  /* Sobre: o texto acende palavra por palavra no ritmo da leitura. */
  function about() {
    const body = $("#about-title ~ .body");
    if (!body) return;
    const words = SplitText.create(body, { type: "words", aria: "none" }).words;
    gsap.fromTo(words, { opacity: 0.16 }, {
      opacity: 1,
      stagger: 0.1,
      ease: "none",
      scrollTrigger: { trigger: body, start: "top 80%", end: "bottom 50%", scrub: 0.6 },
    });
    gsap.from("#about-title ~ .langs", { opacity: 0, y: 12, duration: 0.8, ease: EASE, scrollTrigger: onEnter(body, "bottom 70%") });
  }

  /* Projetos: o destaque abre com máscara sobre a capa; a lista entra item a item com a régua. */
  function projects() {
    const feat = $(".feat");
    if (feat) {
      const tl = gsap.timeline({ scrollTrigger: onEnter(feat, "top 78%"), defaults: { ease: EASE } });
      const h = $("h3", feat);
      if (h) tl.from(SplitText.create(h, { type: "lines", mask: "lines" }).lines, { yPercent: 105, duration: 1.1 });
      tl.from($$(".desc, .tech li, .links", feat), { y: 14, opacity: 0, duration: 0.7, stagger: 0.04 }, 0.25);
      const cover = $(".cover", feat);
      if (cover) {
        tl.from(cover, { clipPath: "inset(100% 0% 0% 0% round 0.75rem)", duration: 1.4, ease: "power4.inOut" }, 0)
          .from(cover, { scale: 1.12, duration: 1.8, ease: "power3.out" }, 0);
        gsap.to(cover, { yPercent: -6, ease: "none", scrollTrigger: { trigger: feat, start: "top bottom", end: "bottom top", scrub: true } });
      }
    }
    for (const row of $$(".list .row")) {
      gsap.timeline({ scrollTrigger: onEnter(row, "top 90%"), defaults: { ease: EASE } })
        .fromTo(row, { "--rule-x": 0 }, { "--rule-x": 1, duration: 1, ease: "power3.inOut" })
        .from(row.children, { y: 20, opacity: 0, duration: 0.8, stagger: 0.06 }, 0.1);
    }
  }

  /* Trajetória: a linha do tempo se desenha com a rolagem; cada marco acende quando a linha chega. */
  function path() {
    const tl = $(".tl");
    if (!tl) return;
    gsap.fromTo(tl, { "--tl": 0 }, {
      "--tl": 1,
      ease: "none",
      scrollTrigger: { trigger: tl, start: "top 70%", end: "bottom 70%", scrub: 0.5 },
    });
    for (const item of $$(".tl .item")) {
      gsap.timeline({ scrollTrigger: onEnter(item, "top 70%"), defaults: { ease: EASE } })
        .fromTo(item, { "--dot": 0 }, { "--dot": 1, duration: 0.6, ease: "back.out(3)" })
        .from(item.children, { x: -16, opacity: 0, duration: 0.8, stagger: 0.08 }, 0.05);
    }
    // Trilhos (cargos no Asaas, desafios na FIAP): o traço se desenha e cada parada acende em ordem.
    for (const rail of $$(".tl .rail")) {
      const steps = $$(".step", rail);
      gsap.timeline({ scrollTrigger: onEnter(rail, "top 75%"), defaults: { ease: EASE } })
        .fromTo(rail, { "--rail": 0 }, { "--rail": 1, duration: 1.2, ease: "power3.inOut" })
        .fromTo(steps, { "--dot": 0 }, { "--dot": 1, duration: 0.6, ease: "back.out(3)", stagger: 0.25 }, 0.2)
        .from(steps.flatMap((s) => [...s.children]), { y: 10, opacity: 0, duration: 0.7, stagger: 0.06 }, 0.3);
    }
  }

  /* Contato: o título sobe letra a letra e o ponto pousa como no hero. */
  function contact() {
    const big = $("#contact-title");
    if (!big) return;
    const txt = $(".txt", big);
    const dot = $(".dot", big);
    if (!txt) return;
    const chars = SplitText.create(txt, { type: "words,chars", mask: "chars", aria: "none" }).chars;
    gsap.timeline({ scrollTrigger: onEnter(big, "top 85%"), defaults: { ease: EASE } })
      .from(chars, { yPercent: 110, duration: 1, stagger: 0.025 })
      .from(dot, { scale: 0, transformOrigin: "50% 85%", duration: 0.7, ease: "back.out(2.6)" }, "-=0.45")
      .from($$("#contact-title ~ .links li"), { y: 16, opacity: 0, duration: 0.7, stagger: 0.08 }, "-=0.6");
  }

  /* Rodapé: a logo gira 180° e o q volta a ser b, fechando o giro do hero. */
  function footer() {
    const mark = $(".foot .mark");
    if (!mark) return;
    gsap.from(mark, { rotation: 180, duration: 1.4, ease: "power3.inOut", scrollTrigger: onEnter(mark, "bottom 98%") });
  }
</script>
